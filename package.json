{
  "name": "appforge",
  "version": "1.0.0",
  "description": "🏗️ Universal App Scaffolding CLI — create complete projects with framework, backend, auth, CI/CD in one command",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "appforge": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "scaffolding",
    "project-generator",
    "cli",
    "expo",
    "flutter",
    "nextjs",
    "vite",
    "supabase",
    "firebase",
    "boilerplate"
  ],
  "author": "magicpro97",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicpro97/appforge.git"
  },
  "homepage": "https://github.com/magicpro97/appforge#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
